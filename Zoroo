def load_cards(filename):
    if not filename.lower().endswith(".txt"):
        raise ValueError("File must have .txt extension")
    cards = []
    try:
        with open(filename, "r", encoding="utf-8") as file:
            for line in file:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("|")
                if len(parts) != 4:
                    continue
                cc, mm_raw, yy_raw, cvv = (part.strip() for part in parts)
                if not cc.isdigit() or not mm_raw.isdigit() or not yy_raw.isdigit() or not cvv.isdigit():
                    continue
                mm = mm_raw.zfill(2)
                yy = yy_raw[-2:] if len(yy_raw) == 4 else yy_raw.zfill(2)
                if not 1 <= int(mm) <= 12:
                    continue
                cards.append({"cc": cc, "mm": mm, "yy": yy, "cvv": cvv})
    except OSError as exc:
        raise OSError(f"Failed to read file: {exc}") from exc
    return cards


def gstr(source: str, start: str, end: str) -> str | None:
    try:
        return source.split(start, 1)[1].split(end, 1)[0]
    except IndexError:
        return ""


def parse_proxy_string(raw):
    text = (raw or "").strip().strip("'\"")
    if not text:
        return None
    scheme = None
    if "://" in text:
        scheme, text = text.split("://", 1)
        scheme = scheme.strip().lower()
    username = password = None
    if "@" in text:
        creds, text = text.rsplit("@", 1)
        if ":" in creds:
            username, password = creds.split(":", 1)
        else:
            username, password = creds, ""
        host, _, port = text.rpartition(":")
    else:
        parts = text.split(":")
        if len(parts) >= 4:
            host, port = parts[0], parts[1]
            username = parts[2]
            password = ":".join(parts[3:])
        elif len(parts) == 3:
            host, port = parts[0], parts[1]
            username, password = parts[2], ""
        else:
            host = parts[0]
            port = parts[1] if len(parts) == 2 else None

    host = host.strip().strip("[]")
    port = int(port) if port is not None else None
    scheme = scheme or "http"
    auth = f"{quote(username, safe='')}:{quote(password or '', safe='')}@" if username else ""
    url = f"{scheme}://{auth}{host}"
    if port is not None:
        url += f":{port}"
    return {"scheme": scheme, "host": host, "port": port, "url": url}


def proxy_dict(parsed):
    return {"http": parsed["url"], "https": parsed["url"]}


def validate_proxy(proxy, target=PROXY_TARGET):
    if not proxy:
        return None
    try:
        parsed = parse_proxy_string(proxy)
    except Exception:
        return None
    try:
        resp = requests.get(target, proxies=proxy_dict(parsed), timeout=15, headers={"user-agent": PROXY_UA})
        if resp.status_code == 200:
            return parsed
    except Exception:
        pass
    return None


