def _supports(char):
    encoding = getattr(sys.stdout, "encoding", None) or "ascii"
    try:
        char.encode(encoding)
        return True
    except (UnicodeEncodeError, LookupError):
        return False


def _symbol(char, fallback):
    return char if _supports(char) else fallback


TICK = _symbol("✔", "[+]")
CROSS = _symbol("✖", "[-]")
PROMPT = _symbol("▹", ">")
BRACKET = _symbol("↳", "[")


class Spinner:
    BRAILLE = ("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
    DOTS = (".", "..", "...", "....", "...", "..")

    def __init__(self, text, duration=4.0, fps=8):
        self.text = text
        self.duration = duration
        self.fps = max(1, fps)
        self.frames = self._build_frames()
        self._stop = threading.Event()
        self._thread = None

    def _build_frames(self):
        base = self.DOTS
        steps = max(1, int(round(self.duration * self.fps)))
        return [base[i % len(base)] for i in range(steps)]

    def _line(self, frame):
        return f"{BRACKET} {self.text} {frame}"

    def _spin(self):
        frame_index = 0
        delay = 1 / self.fps
        sys.stdout.write("\n")
        sys.stdout.flush()

        while not self._stop.is_set():
            frame = self.frames[frame_index % len(self.frames)]
            sys.stdout.write(
                "\033[s"
                "\033[1A"
                "\r" + self._line(frame)
                + "\033[K"
                "\033[u"
            )
            sys.stdout.flush()
            frame_index += 1
            self._stop.wait(delay)

    def _halt(self):
        self._stop.set()
        if self._thread is not None:
            self._thread.join()
            self._thread = None
        sys.stdout.write("\033[1B\r")
        sys.stdout.flush()

    def replace(self, line):
        self._halt()
        sys.stdout.write("\r" + line + "\033[K\n")
        sys.stdout.flush()

    def __enter__(self):
        if not sys.stdout.isatty():
            print(f"{BRACKET} {self.text}")
            return self
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._thread.start()
        return self

    def __exit__(self, *_):
        self._halt()
        return False


class Counter:
    def __init__(self):
        self.live = 0
        self.declined = 0
        self.three_ds = 0
        self._width = 0

    def update(self, result):
        if result == "live":
            self.live += 1
        elif result == "declined":
            self.declined += 1
        elif result == "3ds":
            self.three_ds += 1
        return self

    def text(self):
        return (
            f"{Fore.LIGHTGREEN_EX}LIVE: {Fore.LIGHTWHITE_EX}{self.live}{Style.RESET_ALL}"
            f"{Fore.LIGHTBLACK_EX}  |  {Style.RESET_ALL}"
            f"{Fore.LIGHTRED_EX}DECLINED: {Fore.LIGHTWHITE_EX}{self.declined}{Style.RESET_ALL}"
            f"{Fore.LIGHTBLACK_EX}  |  {Style.RESET_ALL}"
            f"{Fore.YELLOW}THREE3DS: {Fore.LIGHTWHITE_EX}{self.three_ds}{Style.RESET_ALL}"
        )

    def render(self):
        line = self.text()
        visible = len(ANSI.sub("", line))
        sys.stdout.write("\r" + line + " " * max(0, self._width - visible))
        sys.stdout.flush()
        self._width = visible

    def clear(self):
        if not self._width:
            return
        sys.stdout.write("\r" + " " * self._width + "\r")
        sys.stdout.flush()
        self._width = 0


